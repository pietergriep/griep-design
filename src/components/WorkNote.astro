---
// "Learn more" under a carousel card: a small pill that grows into a panel with two
// tabs, Learn more and Details. Renders nothing when there's no text, so cards
// without a note show no button. See scripts/notes.ts for the behaviour.
interface Props {
    text?: string
    details?: string
}
const { text, details = "Details about this project are coming soon." } = Astro.props
---

{
    text && (
        <div class="work-note">
            <div class="wn-panel">
                <div class="wn-head">
                    <div class="wn-tabs" role="tablist">
                        <button class="wn-tab is-active" type="button" role="tab" aria-selected="true" aria-expanded="false" data-tab="0">
                            Learn more
                        </button>
                        <button class="wn-tab" type="button" role="tab" aria-selected="false" data-tab="1">
                            Details
                        </button>
                        <span class="wn-bar" aria-hidden="true" />
                    </div>
                    <button class="wn-close" type="button">Close</button>
                </div>
                <div class="wn-pages">
                    <div class="wn-page is-active" role="tabpanel">
                        <p>{text}</p>
                    </div>
                    <div class="wn-page" role="tabpanel">
                        <p>{details}</p>
                    </div>
                </div>
            </div>
        </div>
    )
}
