---
import "../styles/global.css"
import instances from "../data/instances.json"
import FileStacks from "./islands/FileStacksIsland.tsx"
import GasFeeBar from "./islands/GasFeeBarIsland.tsx"
import WalletWidget from "./islands/WalletWidgetIsland.tsx"
import SwapCard from "./islands/SwapCardIsland.tsx"
import RouteFinder from "./islands/RouteFinderIsland.tsx"
import BusinessCard from "./islands/BusinessCardIsland.tsx"
import WeeklyUsage from "./islands/WeeklyUsageIsland.tsx"
import DCAFlow from "./islands/DCAFlowIsland.tsx"
import WorkImage from "./WorkImage.astro"
import WorkNote from "./WorkNote.astro"

// The whole portfolio page. Rendered at / (pages/index.astro) and, for Dive Club's
// review, at /dive (pages/dive/index.astro) with review: the Inflight review widget,
// noindex, and the page's own links kept inside /dive.
interface Props {
    review?: boolean
}
const { review = false } = Astro.props
const HOME = review ? "/dive/" : "/"

const TITLE = "griep.design"
const DESCRIPTION = "Product designer building clear, considered digital experiences. From concept to interface."

// the "Set your limit" screen is hidden for now; true brings it back
const SHOW_LIMIT_SCREEN = false
---

<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>{TITLE}</title>
        <meta name="description" content={DESCRIPTION} />
        {review && <meta name="robots" content="noindex, nofollow" />}
        {review && <script is:inline src="https://inflight.co/widget.js" data-org="aius9qpt" data-path="/dive" async></script>}
        <meta property="og:type" content="website" />
        <meta property="og:title" content={TITLE} />
        <meta property="og:description" content={DESCRIPTION} />
        <meta property="og:image" content="https://griep.design/og-image.png" />
        <meta name="twitter:card" content="summary_large_image" />
        <link rel="icon" href="/favicon-light.png" media="(prefers-color-scheme: light)" />
        <link rel="icon" href="/favicon-dark.png" media="(prefers-color-scheme: dark)" />
        <link rel="preload" href="/fonts/InterDisplay-Regular.latin.woff2" as="font" type="font/woff2" crossorigin />
        <link rel="preload" href="/fonts/InterDisplay-Medium.latin.woff2" as="font" type="font/woff2" crossorigin />
        <link rel="preload" href="/fonts/Geist-Variable.latin.woff2" as="font" type="font/woff2" crossorigin />
        <!-- the intro's blur-in waits (hidden) until the page has faded in and the font is
             ready, so it reads as its own reveal, like on Framer (see .blur-in in global.css) -->
        <script is:inline>
            ;(function () {
                var html = document.documentElement
                html.classList.add("js")
                var go = function () {
                    if (go.done) return
                    go.done = true
                    requestAnimationFrame(function () {
                        html.classList.add("intro-in")
                    })
                }
                var fonts = document.fonts && document.fonts.ready ? document.fonts.ready : Promise.resolve()
                // the body's page-in fade (global.css); with reduced motion there is none
                var pageIn = new Promise(function (r) {
                    if (matchMedia("(prefers-reduced-motion: reduce)").matches) return r()
                    document.addEventListener("animationend", function (e) {
                        if (e.target === document.body && e.animationName === "page-in") r()
                    })
                })
                Promise.all([fonts, pageIn]).then(go)
                setTimeout(go, 1500) // never keep it hidden longer than this
            })()
        </script>
    </head>
    <body>
        <header class="nav">
            <div class="nav-row">
                <a class="logo" href={HOME} data-carousel-home>griep.design</a>
            </div>
        </header>

        <main>
            <section class="intro">
                <div class="intro-who blur-in">
                    <p class="name">Pieter Griep</p>
                    <p class="role">Product Designer</p>
                </div>
                <!-- two intro texts in one spot: the underlined words swap between them (scripts/intro.ts) -->
                <div class="taglines blur-in blur-in-late">
                    <p class="tagline is-shown" data-tagline="story">
                        As a kid I was installing iPhone betas just to see new interfaces. A few detours later, I’m on the other side of the{" "}
                        <button class="tagline-link" type="button" data-show="process">process</button>.
                    </p>
                    <p class="tagline tagline--process" data-tagline="process" aria-hidden="true" inert>
                        In{" "}
                        <span class="chip-word"><span class="tool-chip"><svg viewBox="0 0 38 57" aria-hidden="true"><path fill="#1abcfe" d="M19 28.5a9.5 9.5 0 1 1 19 0 9.5 9.5 0 0 1-19 0z"/><path fill="#0acf83" d="M0 47.5A9.5 9.5 0 0 1 9.5 38H19v9.5a9.5 9.5 0 1 1-19 0z"/><path fill="#ff7262" d="M19 0v19h9.5a9.5 9.5 0 1 0 0-19H19z"/><path fill="#f24e1e" d="M0 9.5A9.5 9.5 0 0 0 9.5 19H19V0H9.5A9.5 9.5 0 0 0 0 9.5z"/><path fill="#a259ff" d="M0 28.5A9.5 9.5 0 0 0 9.5 38H19V19H9.5A9.5 9.5 0 0 0 0 28.5z"/></svg>Figma</span></span> I explore. With{" "}
                        <span class="chip-word"><span class="tool-chip"><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="#D97757" d="m4.7144 15.9555 4.7174-2.6471.079-.2307-.079-.1275h-.2307l-.7893-.0486-2.6956-.0729-2.3375-.0971-2.2646-.1214-.5707-.1215-.5343-.7042.0546-.3522.4797-.3218.686.0608 1.5179.1032 2.2767.1578 1.6514.0972 2.4468.255h.3886l.0546-.1579-.1336-.0971-.1032-.0972L6.973 9.8356l-2.55-1.6879-1.3356-.9714-.7225-.4918-.3643-.4614-.1578-1.0078.6557-.7225.8803.0607.2246.0607.8925.686 1.9064 1.4754 2.4893 1.8336.3643.3035.1457-.1032.0182-.0728-.164-.2733-1.3539-2.4467-1.445-2.4893-.6435-1.032-.17-.6194c-.0607-.255-.1032-.4674-.1032-.7285L6.287.1335 6.6997 0l.9957.1336.419.3642.6192 1.4147 1.0018 2.2282 1.5543 3.0296.4553.8985.2429.8318.091.255h.1579v-.1457l.1275-1.706.2368-2.0947.2307-2.6957.0789-.7589.3764-.9107.7468-.4918.5828.2793.4797.686-.0668.4433-.2853 1.8517-.5586 2.9021-.3643 1.9429h.2125l.2429-.2429.9835-1.3053 1.6514-2.0643.7286-.8196.85-.9046.5464-.4311h1.0321l.759 1.1293-.34 1.1657-1.0625 1.3478-.8804 1.1414-1.2628 1.7-.7893 1.36.0729.1093.1882-.0183 2.8535-.607 1.5421-.2794 1.8396-.3157.8318.3886.091.3946-.3278.8075-1.967.4857-2.3072.4614-3.4364.8136-.0425.0304.0486.0607 1.5482.1457.6618.0364h1.621l3.0175.2247.7892.522.4736.6376-.079.4857-1.2142.6193-1.6393-.3886-3.825-.9107-1.3113-.3279h-.1822v.1093l1.0929 1.0686 2.0035 1.8092 2.5075 2.3314.1275.5768-.3218.4554-.34-.0486-2.2039-1.6575-.85-.7468-1.9246-1.621h-.1275v.17l.4432.6496 2.3436 3.5214.1214 1.0807-.17.3521-.6071.2125-.6679-.1214-1.3721-1.9246L14.38 17.959l-1.1414-1.9428-.1397.079-.674 7.2552-.3156.3703-.7286.2793-.6071-.4614-.3218-.7468.3218-1.4753.3886-1.9246.3157-1.53.2853-1.9004.17-.6314-.0121-.0425-.1397.0182-1.4328 1.9672-2.1796 2.9446-1.7243 1.8456-.4128.164-.7164-.3704.0667-.6618.4008-.5889 2.386-3.0357 1.4389-1.882.929-1.0868-.0062-.1579h-.0546l-6.3385 4.1164-1.1293.1457-.4857-.4554.0608-.7467.2307-.2429 1.9064-1.3114Z" /></svg>Claude</span></span> I&nbsp;build, iterating with{" "}
                        <button class="tagline-link" type="button" data-show="story">the same curiosity</button> until every detail feels right.
                    </p>
                </div>
            </section>

            <section class="work" id="projects">
                <div class="carousel-buttons">
                    <button class="cbtn" type="button" data-carousel-prev aria-label="Previous project">
                        <span class="arrow arrow-back"></span>
                    </button>
                    <button class="cbtn" type="button" data-carousel-next aria-label="Next project">
                        <span class="arrow arrow-fwd"></span>
                    </button>
                </div>

                <div class="row" data-carousel>
                    <div class="track">
                    <div class="work-item">
                        <div class="card card-business">
                            <span class="badge"><span class="badge-text"><span class="on-mouse">Click</span><span class="on-touch">Tap</span> to flip</span></span>
                            <BusinessCard client:visible />
                        </div>
                        <WorkNote text="My business card as a component. The blocks are the Eixample, the Barcelona neighbourhood I live in, chamfered corners and the Diagonal included. It tilts with your cursor (or your phone), flips on click for a short intro, and the email on the back copies with a click." />
                    </div>

                    <div class="work-item">
                        <div class="card card-usage" data-own-scroll>
                            <span class="badge"><span class="badge-text">Open an agent</span></span>
                            <WeeklyUsage client:visible />
                        </div>
                        <WorkNote text="A workload card for a team of AI agents. One number shows how much of the weekly limit is used, and a pace line says where it will land by the reset. Each agent shows what it's doing right now; open one to read its chat, and press Tab to send the suggested next prompt." />
                    </div>

                    <div class="work-item">
                        <div class="card card-route">
                            <RouteFinder client:visible />
                        </div>
                        <WorkNote text="An AI agent comparing six bridges for the best ETH → SOL swap. Instead of a spinner, it shows each option it checks and why it rules it out, so the final pick is easy to trust. The answer only lands once the title's shimmer has finished its pass, so the switch never happens mid-sweep." />
                    </div>

                    <div class="work-item">
                        <div class="card card-files">
                            <span class="badge"><span class="badge-text">Drag files to stack</span></span>
                            <FileStacks client:visible variants={instances.FileStacks} />
                        </div>
                        <WorkNote text="A file view where loose files get paper-clipped into stacks. Select a few and press Stack, or drop one file onto another; click a stack to fan it open, drag anything to the trash, filter by type. The clip makes grouping feel physical instead of being yet another folder." />
                    </div>

                    <div class="work-item">
                        <div class="card card-swap">
                            <SwapCard client:visible variants={instances.SwapCard} />
                            <span class="badge badge-tight"><span class="badge-text">Try a swap</span></span>
                        </div>
                        <WorkNote spec="swap" text="An ETH → USDC swap card on a live price. Pick a preset or click the amount to type your own; go past your balance and the number shakes and stops at the max. The arrow on the seam flips the pair, every number rolls digit by digit instead of jumping, and the button walks through each step, from quote to done, so you always know where the swap is." />
                    </div>

                    <div class="work-item">
                        <div class="card card-image">
                            <WorkImage name="wallet-home-v3" />
                        </div>
                        <WorkNote text="A wallet home screen. Instead of a chart, one plain sentence says how the wallet did this week, under a balance whose cents are dimmed so the number that matters reads first. Below it, every asset with its change over the chosen period, and Ethereum or Solana one tap away at the top." />
                    </div>

                    <div class="work-item">
                        <div class="card card-gas">
                            <span class="badge"><span class="badge-text">Pick a speed</span></span>
                            <GasFeeBar client:visible variants={instances.GasFeeBar} />
                        </div>
                        <WorkNote text="A gas picker with three speeds: Standard, Fast and Rapid. One highlight slides between them and the price and wait time roll to their new values. The dots form a little flame: the more gas you pay for, the faster it flickers. Speed you can see, not just read." />
                    </div>

                    <div class="work-item">
                        <div class="card card-dca">
                            <span class="badge"><span class="badge-text">Hold to confirm</span></span>
                            <DCAFlow client:visible variants={instances.DCAFlow} />
                        </div>
                        <WorkNote text="Setting up a recurring crypto buy. The summary repeats every choice in plain words, and a hold-to-confirm button makes committing money a deliberate gesture rather than a single tap. Once confirmed, the key details stay on screen as the receipt." />
                    </div>

                    <div class="work-item">
                        <div class="card card-image card-wide-image">
                            <WorkImage name="LWyU3Kwt63ukHhi1DEkQvMJm5Y" />
                        </div>
                        <WorkNote text="A planner widget for the day. Each task shows its time as a bar that fills as it happens, the current one is outlined with the minutes left, and finished tasks fade back with a check." />
                    </div>

                    {SHOW_LIMIT_SCREEN && (
                    <div class="work-item">
                        <div class="card card-image">
                            <WorkImage name="SZB8MGBYtuMoqpmrvEvFoBevFxc" />
                        </div>
                        <WorkNote text="Setting a spending limit on one screen: a big amount, a daily / weekly / monthly switch and a keypad. The line saying you can always change it later takes the pressure off the choice." />
                    </div>
                    )}

                    <div class="work-item">
                        <div class="card card-image card-gradient-widget">
                            <WalletWidget client:visible variants={instances.WalletWidget} />
                        </div>
                        <WorkNote text="A portfolio widget whose gradient follows the time of day, so it looks different every time you open it. Today's value and change sit up top, with a slider showing where it is between its 24-hour low and high." />
                    </div>
                    </div>
                </div>
            </section>
        </main>

        <footer class="footer">
            <div class="footer-inner"><!-- add "appear" back to fade it in once it is in view (scripts/appear.ts) -->
                <a class="logo footer-logo" href={HOME}>griep.design</a>
                <div class="footer-cols">
                    <div class="col col-links">
                        <button class="email" type="button" data-copy-email="hola@griep.design">
                            <span class="swap-label">hola@griep.design</span>
                        </button>
                        <a class="link" href="https://x.com/griep_design" target="_blank" rel="noopener">
                            <span>X</span>
                        </a>
                        <!-- desktop: under the links (phones show it at the bottom, in .footer-end) -->
                        <p class="copyright copyright-desktop">©2026 griep.design. All rights reserved.</p>
                    </div>
                </div>
                <div class="footer-end">
                    <button class="barca" type="button" data-visca-barca>
                        <span class="swap-label">Barcelona, Spain</span>
                    </button>
                    <p class="copyright">©2026 griep.design. All rights reserved.</p>
                </div>
            </div>
        </footer>

        <script>
            import "../scripts/carousel.ts"
            // the settings panel for tuning components: dev server only, left out of builds
            // hidden unless the address ends in ?tune (localhost:4322/?tune, or ?tune=swap for the swap card)
            // (?tune=usage and ?tune=usage-studio are the usage card's own panel instead, see WeeklyUsageIsland)
            if (import.meta.env.DEV && new URLSearchParams(location.search).has("tune") && !new URLSearchParams(location.search).get("tune")?.startsWith("usage")) import("../scripts/tune.ts")
            import "../scripts/footer.ts"
            import "../scripts/cursor.ts"
            import "../scripts/appear.ts"
            import "../scripts/notes.ts"
            import "../scripts/intro.ts"
            import "../scripts/analyse.ts"
            // import "../scripts/xray.ts" // the exploded drawing on "Learn more" (File Explorer): hidden for now
        </script>
    </body>
</html>
