---
// Dev server only (injected in astro.config.mjs, never built): tune the portfolio
// "Tasks today" with DialKit at localhost:4322/tune/tasks.
import "../styles/global.css"
import TasksTune from "./TasksTune.tsx"
---

<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="robots" content="noindex" />
        <title>Tasks today · tune</title>
        <link rel="preload" href="/fonts/Geist-Variable.latin.woff2" as="font" type="font/woff2" crossorigin />
    </head>
    <body class="tune-page">
        <a class="tune-back" href="/">← Portfolio</a>
        <main class="tune-stage">
            <TasksTune client:only="react" />
        </main>
        <style is:global>
            /* the card as it sits in the carousel, centred; no page fade-in here */
            body.tune-page {
                animation: none;
                opacity: 1;
            }
            .tune-back {
                position: fixed;
                top: 20px;
                left: var(--gutter);
                font-size: 14px;
                color: rgb(140, 140, 140);
                text-decoration: none;
            }
            .tune-back:hover {
                color: rgb(20, 20, 20);
            }
            .tune-stage {
                min-height: 100dvh;
                padding: 0;
                display: flex;
                flex-direction: column;
                align-items: center;
                justify-content: center;
                gap: 12px;
            }
            .tune-note {
                min-height: 1.4em;
                margin: 0;
                font-size: 14px;
                color: rgb(140, 140, 140);
            }
        </style>
    </body>
</html>
