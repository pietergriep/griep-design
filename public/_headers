# Cloudflare Pages: built files have hashed names, media and fonts never change in place
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
/media/*
  Cache-Control: public, max-age=31536000, immutable
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
# the Dive Club review copy (/dive): never indexed
/dive
  X-Robots-Tag: noindex, nofollow
/dive/*
  X-Robots-Tag: noindex, nofollow
